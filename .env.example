# ===========================================
# AMDOX ERP - Environment Variables Template
# Copy to .env and fill in values
# ===========================================

# Database
POSTGRES_USER=amdox
POSTGRES_PASSWORD=change_me_in_production
POSTGRES_DB=amdox_erp
DATABASE_URL="postgresql://amdox:change_me_in_production@localhost:5432/amdox_erp"

# Redis
REDIS_PASSWORD=change_me_in_production
REDIS_URL="redis://:change_me_in_production@localhost:6379"

# JWT
JWT_SECRET=your_super_secret_jwt_key_min_32_chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your_refresh_secret_min_32_chars
JWT_REFRESH_EXPIRES_IN=7d

# Keycloak
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=amdox
KEYCLOAK_CLIENT_ID=amdox-api
KEYCLOAK_CLIENT_SECRET=your_keycloak_client_secret
KC_ADMIN_PASSWORD=change_me_in_production

# API
API_PORT=3001
API_URL=http://localhost:3001
CORS_ORIGINS=http://localhost:3000

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_GRAPHQL_URL=http://localhost:3001/graphql
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ML Service
ML_SERVICE_URL=http://localhost:8000
ML_SERVICE_PORT=8000

# AWS / MinIO (use MinIO for local dev)
AWS_ACCESS_KEY_ID=minio_admin
AWS_SECRET_ACCESS_KEY=minio_secret
AWS_REGION=ap-south-1
AWS_S3_BUCKET=amdox-erp
S3_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minio_admin
MINIO_SECRET_KEY=minio_secret

# Email (use Mailhog for local dev)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@amdox.com

# Elasticsearch
ELASTICSEARCH_URL=http://localhost:9200

# External APIs
OPENEXCHANGERATES_API_KEY=your_api_key_here

# Security
ENCRYPTION_KEY=32_char_encryption_key_here_fill
WEBHOOK_SECRET=your_webhook_hmac_secret
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=100

# Monitoring
PROMETHEUS_PORT=9090
GRAFANA_PORT=3002
